# Google Maps Platform key: Geocoding API (optional for stage 1) and Street View Static API (required for stage 2).
# GOOGLE_MAPS_API_KEY=

# Everything below is optional; defaults shown. Relative paths are resolved from this folder.
# OUTPUT_DIR=output
# HTTP_TIMEOUT=10
# HTTP_MAX_RETRIES=3

# Stage 1
# GEOCODE_CACHE_PATH=.cache/geocode.sqlite

# Stage 2
# STREETVIEW_CACHE_PATH=.cache/streetview.sqlite
# STREETVIEW_SIZE=640x640
# STREETVIEW_FOV=90

# Stage 3
# DETECT_CACHE_PATH=.cache/detect.sqlite
# SEG_MODEL=facebook/mask2former-swin-large-mapillary-vistas-semantic
# DETECTOR_MODEL=yolo11x.pt
# STOP_SIGN_THRESHOLD=0.4
# RAMP_MIN_SCORE=0.30              # RampNet score for a point to count as a curb ramp
# RAMP_MIN_AREA_FRACTION=0.001     # a segmented curb-cut region needs this share of the image ...
# RAMP_MIN_CONFIDENCE=0.55         # ... and this confidence to count without a RampNet point
# SEG_INPUT_SIZE=1024
# DETECT_BATCH_SIZE=4
# HF_HOME=D:/hf-cache

# Your own images (--images-dir)
# IMAGE_SOURCE_TYPE=phone          # or google_screenshot

# Stage 4
# CAMERA_HEIGHT_M=2.5
# STOP_SIGN_WIDTH_M=0.762          # 0.914 for 36 in signs on multi-lane roads
# DEPTH_MODEL=depth-anything/Depth-Anything-V2-Metric-Outdoor-Large-hf
# MEASURE_CONFIDENCE_THRESHOLD=0.5

# What Stage 3 detects: any of ramps, driveways, signs, poles, curbs (comma separated), or all
# DETECT=all
# DRIVEWAY_MIN_SCORE=0.2
# DRIVEWAY_MIN_AREA_FRACTION=0.005

# Ramp slope from a `ramp` folder of photos (see README). The default checkpoint is non-commercial.
# VGGT_MODEL=facebook/VGGT-1B
# MULTIVIEW_MAX_VIEWS=6
# MULTIVIEW_CROP_FACTOR=2.0
